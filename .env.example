# Telegram (BotFather se bot banao, @userinfobot se chat id lo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading account (optional - sirf position size calculate karne ke liye)
EQUITY_USDT=100
RISK_PER_TRADE_PCT=1

# Strategy knobs (default = 45-day backtest par tuned)
MIN_SCORE=8
MAX_SIGNALS_PER_DAY=6
MAX_NEW_PER_RUN=2
MAX_PER_SIDE_PER_RUN=2
COOLDOWN_HOURS=4

# MMC (Mirror Market Concept) layer
# 1 = MMC confluence zaroori (BOS/CHoCH, FVG, sweep, discount/premium)
MMC_FILTER=1
# 1 = koi bhi MMC confluence kaafi; 2-3 = zyada strict (kam signals)
MMC_MIN_POINTS=1
# QFL = origin line ka retest + hold, QB = quantity box ke andar se entry
QFL_FILTER=1
QB_FILTER=1
# 1 = QFL ya QB zaroori (strict); 0 = sirf confirmation/confidence points
QFL_REQUIRE=1
# 4h trend alignment (BOS ke saath HTF confirmation)
HTF_FILTER=1

# News digest (crypto + forex + macro, Hinglish mein)
NEWS_ENABLED=1
NEWS_INTERVAL_HOURS=1
NEWS_LOOKBACK_HOURS=24
NEWS_MAX_CRYPTO=4
NEWS_MAX_MACRO=3

# Filters
BTC_FILTER=1
BTC_STRICT=0
ATR_MIN_PCT=0.25
ATR_MAX_PCT=3.0
VOL_MULT=1.2

# Risk levels
MIN_RISK_PCT=0.5
MAX_RISK_PCT=3.0
STOP_PAD_ATR=0.5
MIN_STOP_ATR=1.2
MAX_HOLD_HOURS=72

# Local dry-run: 1 = Telegram par bhejne ke bajaye screen par print karo
DRY_RUN=0
